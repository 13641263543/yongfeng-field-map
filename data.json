 "about": {
  "titles": [
   {
    "t": "《田埂退潮之后》",
    "s": "浙东四村散点行走下，土地流转中的村民职业重构与公共空间身体落点",
    "m": "田野艺术民族志 · 田野艺术研究课程汇报"
   },
   {
    "t": "《屋檐之间》",
    "s": "临海市永丰镇散村公共空间与在地身体经验研究",
    "m": "2026 年 10 月 · 永丰镇下乡复访"
   }
  ],
  "origin": "在吴岸村，先想采访一位老人，被轰走了；想让自己显得更有亲和力，就去村里的超市买了一块巧克力，碰上了很好客的超市老板。他说起两三年前地被统一收走承包，说村里人现在分成三类：出去打工的、留在村里接零工的、没有活只能在家闲着的。所有无处可去的人，最后都聚在超市这一片屋檐下。",
  "hypothesis": "越往深山走，种地的痕迹越重，屋檐下闲坐的人越少；越靠近平原公路，土地流转越彻底，屋檐下聚的人越多。于是逆着这条线，去走另外三个村。",
  "question": "散村的“公共性”到底藏在哪里？",
  "methods": [
   {
    "k": "感官行走",
    "v": "用身体走完四个村，记录土地痕迹、劳作场景和聚集点：气味、声音、温度。"
   },
   {
    "k": "口述民族志",
    "v": "和村民闲聊、半结构访谈，收集土地流转的个人记忆版本。"
   },
   {
    "k": "身体视角",
    "v": "看人从“下地劳作”到“屋檐闲坐”的身体状态变化。"
   },
   {
    "k": "参与式观察",
    "v": "复访时在三个村各待一段时间，看人们在哪里停下来、和谁说话。"
   }
  ],
  "findings": [
   {
    "k": "职业梯度",
    "v": "从「跟着田走」到「等着活来」：自耕与家庭代工 → 庭院轻种植 → 建房事务与本地零工 → 外出务工 / 村内零工 / 居家闲置。"
   },
   {
    "k": "公共空间退潮",
    "v": "田埂·晒场 → 家门口院落 → 连通廊檐·巷道 → 超市屋檐。屋檐不是普通的建筑结构，是田消失之后，散村人临时安放身体的新空间。"
   },
   {
    "k": "记忆分叉",
    "v": "同一个村的土地流转，超市老板和爷爷讲出了两套版本：时间、补偿、感受都不一样。"
   },
   {
    "k": "用错了地方",
    "v": "不是空间没人用，是用错了地方：新修的凉亭白天空无一人，大家在柴火堆旁聊天；屋檐、台阶才是真正的聚集点。"
   }
  ],
  "install": [
   {
    "k": "四组并置行走影像",
    "v": "东安、横山腰、姜家岙、吴岸，四组行走画面并排循环。"
   },
   {
    "k": "身体落点坐具装置",
    "v": "田埂的土坡、门口的石墩、廊檐的长凳、屋檐下的塑料凳，按顺序对应四个村。"
   },
   {
    "k": "口述声音装置",
    "v": "耳机里两段土地流转的口述版本；作品不评判土地政策的好坏，只把个体的记忆摆在一起。"
   }
  ],
  "limits": [
   "只走了四个村，样本小；不是严格的定量研究。",
   "信息来自村民口述，没有官方统计数据；没有和地方官方数据对照。",
   "外来者视角：听不懂方言，很多细节可能被翻译掉了。",
